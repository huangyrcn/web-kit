# SearXNG for web-kit v2: serves ONLY the API-backed engines.
# Google / DuckDuckGo / Google Scholar / Semantic Scholar / arXiv are scraped by
# webkit-api through Chrome and are deliberately not configured here.
# webkit-api reaches this instance on 127.0.0.1:8080 only.
#
# server.secret_key comes from the SEARXNG_SECRET environment variable.

use_default_settings:
  engines:
    keep_only:
      - bing
      - openalex
      - pubmed
      - github
      - github code
      - gitlab
      - huggingface
      - pypi
      - npm
      - crates.io
      - lib.rs
      - pkg.go.dev
      - sourcehut
      - microsoft learn
      - nvd
      - hackernews
      - stackoverflow
      - wikidata
      - annas archive
      - zlibrary

server:
  secret_key: "set-via-SEARXNG_SECRET"
  limiter: false
  image_proxy: false
  public_instance: false
  methods: ["GET"]

valkey:
  url: false

search:
  default_lang: "en"
  formats: ["json"]
  suspended_times:
    SearxEngineAccessDenied: 60
    SearxEngineCaptcha: 120
    SearxEngineTooManyRequests: 60
    cf_SearxEngineCaptcha: 300
    cf_SearxEngineAccessDenied: 300
    recaptcha_SearxEngineCaptcha: 300

outgoing:
  request_timeout: 8.0
  pool_connections: 100
  pool_maxsize: 20
  enable_http2: true

engines:
  - name: bing
    engine: bing
    disabled: false
    send_accept_language_header: true

  - name: openalex
    engine: openalex
    disabled: false

  - name: pubmed
    engine: pubmed
    shortcut: pm
    disabled: false

  - name: github
    engine: github
    shortcut: gh
    disabled: false

  # Code search needs a token: https://github.com/settings/tokens (no scopes).
  - name: github code
    engine: github_code
    shortcut: ghc
    disabled: true
    ghc_auth:
      type: "token"
      token: "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"

  - name: gitlab
    engine: gitlab
    disabled: false

  - name: huggingface
    engine: huggingface
    disabled: false

  - name: pypi
    engine: pypi
    disabled: false

  - name: npm
    engine: npm
    disabled: false

  - name: crates.io
    engine: crates
    disabled: false

  - name: lib.rs
    engine: lib_rs
    disabled: false

  - name: pkg.go.dev
    engine: pkg_go_dev
    disabled: false

  - name: sourcehut
    engine: sourcehut
    disabled: false

  - name: microsoft learn
    engine: microsoft_learn
    disabled: false

  - name: nvd
    engine: nvd
    disabled: false

  - name: hackernews
    engine: hackernews
    disabled: false

  - name: stackoverflow
    engine: stackexchange
    shortcut: st
    api_site: "stackoverflow"
    categories: [it, q&a]
    disabled: false

  - name: wikidata
    engine: wikidata
    shortcut: wd
    disabled: false

  - name: annas archive
    engine: annas_archive
    disabled: false

  - name: zlibrary
    engine: zlibrary
    shortcut: zlib
    disabled: false
