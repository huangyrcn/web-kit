{
	admin off
	auto_https off
	# start-caddy.sh refuses to start unless WEBKIT_API_KEY, WEBKIT_ADMIN_KEY and
	# WEBKIT_NOVNC_HASH are all non-empty: an empty key would make the header
	# matchers accept header-less requests.
}

# API — the only port clients need.
#   /v2/admin/*  X-Admin-Key
#   /v2/*        X-API-Key
#   anything else (SearXNG, /internal/*) is not reachable from outside.
:8082 {
	@admin path /v2/admin/*
	handle @admin {
		@admin_ok header X-Admin-Key "{$WEBKIT_ADMIN_KEY}"
		handle @admin_ok {
			reverse_proxy 127.0.0.1:3100
		}
		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized","message":"X-Admin-Key required"}` 401
		}
	}

	@api path /v2/*
	handle @api {
		@api_ok header X-API-Key "{$WEBKIT_API_KEY}"
		handle @api_ok {
			reverse_proxy 127.0.0.1:3100 {
				flush_interval -1
			}
		}
		handle {
			header Content-Type application/json
			respond `{"error":"unauthorized","message":"X-API-Key required"}` 401
		}
	}

	handle {
		header Content-Type application/json
		respond `{"error":"not_found","message":"only /v2/* is served"}` 404
	}
}

# noVNC for manual logins / CAPTCHAs (HTTP Basic Auth: webkit / WEBKIT_ADMIN_KEY).
:6080 {
	basic_auth {
		webkit {$WEBKIT_NOVNC_HASH}
	}
	reverse_proxy 127.0.0.1:6081
}

# Raw Chrome CDP, admin only (debugging).
:9223 {
	@cdp_ok header X-Admin-Key "{$WEBKIT_ADMIN_KEY}"
	handle @cdp_ok {
		reverse_proxy 127.0.0.1:9222
	}
	handle {
		respond "unauthorized" 401
	}
}
