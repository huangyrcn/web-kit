# web-kit v2 backend settings. Copy to .env (chmod 600) and fill in.

# Interface for the published ports. 127.0.0.1 = this host only; set 0.0.0.0
# to serve the LAN (all three ports are authenticated by Caddy).
WEBKIT_BIND=127.0.0.1
WEBKIT_API_PORT=8082
WEBKIT_VNC_PORT=6080
WEBKIT_CDP_PORT=9223
WEBKIT_CONTAINER=web-kit
WEBKIT_IMAGE=web-kit:v2
WEBKIT_MEM_LIMIT=4g
WEBKIT_MAX_PAGES=5
# Browser time zone; set it to the region of this host's egress IP.
WEBKIT_TZ=UTC

# Client key (X-API-Key): search / page / crawl / download / status.
#   openssl rand -hex 32
WEBKIT_API_KEY=

# Admin key (X-Admin-Key): /v2/admin/*, raw CDP on 9223, noVNC password.
# Must differ from WEBKIT_API_KEY.
WEBKIT_ADMIN_KEY=

# bcrypt hash of WEBKIT_ADMIN_KEY for noVNC basic auth (user "webkit"):
#   docker run --rm caddy:2 caddy hash-password --plaintext "$WEBKIT_ADMIN_KEY"
# Keep the single quotes: the hash contains '$'.
WEBKIT_NOVNC_HASH=''

# Optional extra VNC password (noVNC is already behind basic auth).
WEBKIT_VNC_PASSWORD=

# SearXNG secret_key.  openssl rand -hex 32
SEARXNG_SECRET=
