# web-kit server settings. Copy to backend/.env (chmod 600) and fill in.

# Address the two ports are published on: one only trusted clients reach, such as
# this host's tailnet address (`tailscale ip -4`). Required.
WEBKIT_BIND=
WEBKIT_API_PORT=8082
WEBKIT_VNC_PORT=6080
WEBKIT_CONTAINER=web-kit
WEBKIT_IMAGE=web-kit:server
WEBKIT_MEM_LIMIT=4g
# Requests served at once; the rest wait, then get `busy` (exit 7).
WEBKIT_MAX_INFLIGHT=4
# Browser time zone; set it to the region of this host's egress IP.
WEBKIT_TZ=UTC

# Client key (X-API-Key): search / read / download / status.   openssl rand -hex 32
WEBKIT_API_KEY=
# Admin key (X-Admin-Key): /v2/admin/*, and the noVNC password (user "webkit").
# Must differ from WEBKIT_API_KEY.
WEBKIT_ADMIN_KEY=

# Optional: Semantic Scholar API key (opencli's semanticscholar adapter uses it).
WEBKIT_S2_API_KEY=
